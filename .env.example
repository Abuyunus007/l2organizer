BIND_ADDR=0.0.0.0:9001
RUST_LOG=l2o_web=info,l2o_core=info,tower_http=info,sqlx=warn
# Password for the initial 'admin' user, used only when no users exist yet.
# Change it after first login (or delete the row and let it reseed).
ADMIN_PASSWORD=change-me

# Game accounts with this access level or higher can log into the admin area
# with their game credentials and are flagged as GM in the player portal.
GM_ACCESS_LEVEL=50

